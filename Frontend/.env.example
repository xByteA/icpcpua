VITE_DATA_BACKEND=firebase
# Set to true to share data between browsers through Firestore (needed for a shared leaderboard). Anything else keeps all data in this browser only.
# When true, email-and-password accounts are Firebase Authentication accounts. Before setting it, enable the
# Email/Password provider in the Firebase console (Authentication > Sign-in method) and deploy firestore.rules.
VITE_FIRESTORE_ENABLED=false
# Local development only. true sends Authentication and Firestore to the Firebase emulators
# (npx firebase-tools emulators:start --only auth,firestore) instead of the real project. Never set it in production.
VITE_FIREBASE_EMULATORS=false
